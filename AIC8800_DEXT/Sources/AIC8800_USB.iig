#include <DriverKit/IOTypes.h>
#include <USBDriverKit/IOUSBHostDevice.h>
#include <USBDriverKit/IOUSBHostInterface.h>

// ============================================================================
// AIC8800 USB Driver Interface
// ============================================================================

interface AIC8800_USB : IOUSBHostDevice
{
    struct AIC8800_DriverData *driver_data;

    IOUSBHostDevice *usb_device;
    IOUSBHostInterface *usb_interface;
    IOUSBHostPipe *bulk_in_pipe;
    IOUSBHostPipe *bulk_out_pipe;
    IOUSBHostPipe *interrupt_pipe;
    uint8_t interface_number;

    // USB Lifecycle
    kern_return_t Start(IOService *provider) override;
    kern_return_t Stop(IOService *provider) override;
    void Free() override;

    // Device Matching
    kern_return_t InitwithDevice(IOUSBHostDevice *device,
                         IOUSBHostInterface *usbInterface);

    // Register I/O
    kern_return_t ReadRegister(uint16_t address, uint32_t *value);
    kern_return_t WriteRegister(uint16_t address, uint32_t value);

    // Memory Access
    kern_return_t ReadMemory(uint16_t address, void *buffer, uint32_t length);
    kern_return_t WriteMemory(uint16_t address, const void *buffer, uint32_t length);

    // Firmware Operations
    kern_return_t LoadFirmware(const uint8_t *data, uint32_t length);
    kern_return_t VerifyFirmware(void);
    kern_return_t ResetDevice(void);

    // Mode Switch
    kern_return_t PerformModeSwitch(void);
    kern_return_t SendSCSICommand(const uint8_t *cdb, uint8_t cdb_len,
                                  void *data, uint32_t data_len, bool is_data_in);

    // Data Transfer
    kern_return_t SendData(const void *data, uint32_t length);
    kern_return_t ReceiveData(void *buffer, uint32_t length, uint32_t *actual_length);
    kern_return_t SendControlTransfer(uint8_t request, uint16_t value,
                                      uint16_t index, void *data,
                                      uint32_t length, bool is_in);

    // Interrupt Handling
    kern_return_t HandleInterrupt(void);
    kern_return_t EnableInterrupts(void);
    kern_return_t DisableInterrupts(void);
};

// ============================================================================
// USB Control Transfer Structures
// ============================================================================

struct AIC8800_USB_ControlRequest {
    uint8_t  bmRequestType;
    uint8_t  bRequest;
    uint16_t wValue;
    uint16_t wIndex;
    uint16_t wLength;
} __attribute__((packed));

// ============================================================================
// USB Bulk Transfer Header
// ============================================================================

struct AIC8800_USB_BulkHeader {
    uint8_t  type;
    uint8_t  flags;
    uint16_t length;
    uint16_t sequence;
    uint16_t reserved;
} __attribute__((packed));
